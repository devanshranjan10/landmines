// landmine.tech: a Worker serving .site-dist/ (built by scripts/site/build.mjs) and the hosted MCP server at /mcp.
// Secret: GITHUB_TOKEN, a GitHub token with no scopes (`wrangler secret put GITHUB_TOKEN -c scripts/site/wrangler.jsonc`).
// The custom domains create their own DNS records and certificates in the landmine.tech zone.
{
  "name": "landmine-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../.site-dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "landmine.tech", "custom_domain": true },
    { "pattern": "www.landmine.tech", "custom_domain": true }
  ],
  "workers_dev": true,
  // 60 MCP and lookup requests a minute per IP; lookups are cached for a day.
  "ratelimits": [{ "name": "MCP_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  // Lookup results, global, kept 30 days: served when GitHub rate-limits a spike (src/remote.ts edgeCache).
  "kv_namespaces": [{ "binding": "LOOKUPS", "id": "10f1fd50d73f42108472274002e6e0c4" }],
  "observability": { "enabled": true }
}
