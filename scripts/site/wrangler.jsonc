// landmine.tech: a Worker serving .site-dist/ (built by scripts/site/build.mjs); worker.js only redirects http and www.
// The custom domains create their own DNS records and certificates in the landmine.tech zone.
{
  "name": "landmine-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../.site-dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "landmine.tech", "custom_domain": true },
    { "pattern": "www.landmine.tech", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": false }
}
