e":0.7,"sources":["span"]},{"name":"React.useCallback","score":0.7,"sources":["span"]},{"name":"trapped","score":0.7,"sources":["span"]},{"name":"useCallback","score":0.7,"sources":["span"]},{"name":"Drawer.Content","score":0.25,"sources":["code"]},{"name":"Drawer.Portal","score":0.5,"sources":["code"]},{"name":"Portal","score":0.5,"sources":["code"]},{"name":"dist","score":0.24,"sources":["span"]}],"workaround":{"kind":"workaround","author":"stephane-segning","association":"NONE","url":"https://github.com/emilkowalski/vaul/issues/653","createdAt":"2026-08-14T17:41:14Z","reactions":0,"excerpt":"We're using vaul's `Root`'s `modal` prop as a lever to temporarily stand down the drawer's own Radix `FocusScope`/`DismissableLayer` while an unrelated, independently-portaled modal library (Headless UI's `Dialog`, in our case) is opened from inside the drawer — vaul's `Content` renders `@radix-ui/react-dialog`'s own `Content` underneath, and `modal` is what that library keys `FocusScope`'s `trapped` behaviour on (`DialogContentModal` vs. `DialogContentNonModal`). That workaround needed `modal` to change on an already-open drawer, which is what surfaced this.\n\n## Workaround we used\n\nDon't hand `Overlay` a new `modal` value while it's mounted — unmount the element outright instead, so React\n…","signals":["says workaround","suggests a fix","has code"]}},{"id":"emilkowalski/vaul#656","ecosystem":"npm","package":"vaul","version":"1.1.2","issue":{"number":656,"title":"Body scroll lock is never released when a drawer closes (only when its Root unmounts)","url":"https://github.com/emilkowalski/vaul/issues/656","createdAt":"2026-08-27T08:19:41Z","updatedAt":"2026-08-27T08:19:41Z","author":"Vallo33","labels":[],"reactions":0,"comments":0},"evidence":{"strength":"strong","where":"body","kind":"adjacent","quote":"- vaul **1.1.2** (latest)"},"symbols":[{"name":"Content","score":0.5,"sources":["span","code"]},{"name":"Drawer.Content","score":0.5,"sources":["span","code"]},{"name":"Drawer.Root","score":1,"sources":["span","code"]},{"name":"Root","score":0.5,"sources":["span","code","title"]},{"name":"Drawer","score":0.45,"sources":["span","import"]},{"name":"animationend","score":0.7,"sources":["span"]},{"name":"Dialog","score":0.7,"sources":["span"]},{"name":"DialogPrimitive","score":0.7,"sources":["span"]},{"name":"DialogPrimitive.Root","score":0.7,"sources":["span"]},{"name":"head","score":0.7,"sources":["span"]},{"name":"modal","score":0.35,"sources":["span"]},{"name":"overflow","score":0.7,"sources":["span"]},{"name":"Presence","score":0.7,"sources":["span"]},{"name":"useEffect","score":0.7,"sources":["span"]},{"name":"useLockAttribute","score":0.7,"sources":["span"]},{"name":"Description","score":0.5,"sources":["code"]},{"name":"Drawer.Description","score":0.5,"sources":["code"]},{"name":"Drawer.Overlay","score":0.5,"sources":["code"]},{"name":"Drawer.Portal","score":0.5,"sources":["code"]},{"name":"Drawer.Title","score":0.5,"sources":["code"]},{"name":"Overlay","score":0.5,"sources":["code"]},{"name":"Portal","score":0.5,"sources":["code"]},{"name":"Title","score":0.5,"sources":["code"]},{"name":"body","score":0.24,"sources":["span"]},{"name":"open","score":0.24,"sources":["span"]}],"workaround":{"kind":"workaround","author":"Vallo33","association":"NONE","url":"https://github.com/emilkowalski/vaul/issues/656","createdAt":"2026-08-27T08:19:41Z","reactions":0,"excerpt":"The measurements above are from jsdom (vitest + Testing Library), where I dispatch the `animationend` that Radix's `Presence` waits on, since jsdom never fires it. The user-visible symptom that led me here was on a real iOS device — a page that could not be scrolled after closing a bottom drawer until it was reloaded — and the workaround below fixed it there, so I don't think the manual dispatch is what creates it. Happy to put together a browser-based repro if that would help.\n\n### Workaround, for anyone else hitting this\n\nKeep the drawer mounted for its exit animation, then take it out of the tree:\n\n```jsx\nfunction useDrawerPresence(isOpen) {\n  const [isMounted, setIsMounted] = React.useState(isOpen);\n  React.useEffect(() => {\n    if (isOpen) { setIsMounted(true); return; }\n    if (!isMounted) return;\n    const t = setTimeout(() => setIsMounted(false), 500); // TRANSITIONS.DURATION\n    return () => clearTimeout(t);\n  }, [isOpen, isMounted]);\n  return isOpen || isMounted;\n}\n```\n…","signals":["says workaround","suggests a fix","has code"]}},{"id":"emilkowalski/vaul#657","ecosystem":"npm","package":"vaul","version":"1.1.2","issue":{"number":657,"title":"iOS scroll lock cancels all touchmove for scrollers inside a shadow root","url":"https://github.com/emilkowalski/vaul/issues/657","createdAt":"2026-08-27T12:24:12Z","updatedAt":"2026-08-27T13:47:12Z","author":"pranshugupta54","labels":[],"reactions":0,"comments":1},"evidence":{"strength":"strong","where":"body","kind":"adjacent","quote":"- vaul 1.1.2"},"symbols":[{"name":"composedPath","score":0.7,"sources":["span"]},{"name":"Content","score":0.35,"sources":["span"]},{"name":"document","score":0.7,"sources":["span"]},{"name":"document.documentElement","score":0.7,"sources":["span"]},{"name":"documentElement","score":0.7,"sources":["span"]},{"name":"Drawer","score":0.35,"sources":["span"]},{"name":"Drawer.Content","score":0.35,"sources":["span"]},{"name":"Drawer.Root","score":0.7,"sources":["span"]},{"name":"e.target","score":0.7,"sources":["span"]},{"name":"getRootNode","score":0.7,"sources":["span"]},{"name":"getRootNode.host","score":0.7,"sources":["span"]},{"name":"getScrollParent","score":0.7,"sources":["span"]},{"name":"hidden","score":0.7,"sources":["span"]},{"name":"host","score":0.7,"sources":["span"]},{"name":"onTouchMove","score":0.7,"sources":["span"]},{"name":"parentElement","score":0.7,"sources":["span"]},{"name":"preventScrollMobileSafari","score":0.7,"sources":["span"]},{"name":"repositionInputs","score":0.7,"sources":["span"]},{"name":"Root","score":0.3