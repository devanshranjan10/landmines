    given-names: Devansh
repository-code: "https://github.com/devanshranjan10/landmines"
url: "https://landmine.tech/"
license: MIT
version: 0.2.0
date-released: "2026-10-21"
keywords:
  - coding agents
  - dependencies
  - known bugs
  - lockfile
  - benchmark
